# Private batch-tester access
BENCHMARK_ADMIN_KEY=replace-with-a-long-random-value

# IMPORTANT: Point this only at the separate staging/test CSA backend.
BENCHMARK_TARGET_URL=https://your-csa-staging-backend.onrender.com
BENCHMARK_CONCURRENCY=3
BENCHMARK_TIMEOUT_MS=300000

# Recommended: a test user in the staging Supabase project.
BENCHMARK_SUPABASE_URL=https://your-staging-project.supabase.co
BENCHMARK_SUPABASE_ANON_KEY=your-staging-anon-key
BENCHMARK_USER_EMAIL=benchmark-test-user@example.com
BENCHMARK_USER_PASSWORD=replace-me

# Alternative to the four login variables above (tokens expire, so login is preferred):
# BENCHMARK_TARGET_TOKEN=
