# Private batch-tester access
BENCHMARK_ADMIN_KEY=replace-with-a-long-random-value

# IMPORTANT: Point this only at the separate staging/test CSA backend.
BENCHMARK_TARGET_URL=https://your-csa-staging-backend.onrender.com
BENCHMARK_TARGET_INTERNAL_KEY=use-the-same-private-key-configured-on-the-test-backend
BENCHMARK_CONCURRENCY=1
BENCHMARK_TIMEOUT_MS=300000

# Reliability settings for Render Free staging services.
# The runner wakes the target through /health before sending chart images.
BENCHMARK_WARMUP_ATTEMPTS=5
BENCHMARK_WARMUP_TIMEOUT_MS=90000
BENCHMARK_WARMUP_DELAY_MS=5000

# HTTP 429/502/503/504 responses are retried with exponential backoff.
BENCHMARK_TARGET_MAX_ATTEMPTS=4
BENCHMARK_RETRY_BASE_MS=15000
BENCHMARK_RETRY_MAX_MS=120000
BENCHMARK_BETWEEN_CHART_MS=3000

# Configure these only on the separate staging/test analysis backend:
# BENCHMARK_DRY_RUN_ENABLED=true
# BENCHMARK_INTERNAL_KEY=the-same-private-key-used-above
